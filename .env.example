###############################################################################
# Trip2World — environment configuration
#
#   cp .env.example .env
#   pnpm secrets:generate        # fills every CHANGE_ME secret with real entropy
#
# Never commit .env. Never reuse these values between deployments.
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# Host paths
# ─────────────────────────────────────────────────────────────────────────────

# Where persistent data lives on the host. The CasaOS convention is
# /DATA/AppData/<app>. Postgres, Redis and Caddy all bind-mount subdirectories of
# this path, so it is the single directory to back up (and the single directory to
# restore into). Must exist with the correct ownership BEFORE the first start —
# see docs/DEPLOYMENT.md.
DATA_ROOT=/DATA/AppData/Trip2World

# ─────────────────────────────────────────────────────────────────────────────
# Public addressing
# ─────────────────────────────────────────────────────────────────────────────

# Public hostname for the user-facing app.
APP_DOMAIN=call.trip2fun.com

# Canonical base URL. Must be https:// in production — secure cookies are refused
# over plain http, which will silently break login.
APP_URL=https://call.trip2fun.com

# Separate hostname for the admin panel.
#
# This is a security boundary, not cosmetics. On its own origin the admin session
# cookie is never attached to a request made by the public app, so an XSS in the
# user-facing bundle cannot ride a moderator's session. Both hostnames serve
# /api from the SAME api container, which is what lets each panel authenticate
# same-origin and keeps the cookies host-scoped rather than shared across
# *.trip2fun.com.
ADMIN_DOMAIN=admin.trip2fun.com
ADMIN_URL=https://admin.trip2fun.com

# Host ports the reverse proxy binds to. Your external Cloudflare Tunnel maps:
#
#   http://<host>:8181  ->  https://call.trip2fun.com
#   http://<host>:8182  ->  https://admin.trip2fun.com
#
# Caddy routes by PORT rather than by Host header, so the admin panel cannot be
# reached by spoofing a Host header at the public port.
PUBLIC_PORT=8181
ADMIN_PORT=8182

# Which host interface those ports bind to.
#
# 127.0.0.1  (recommended) The tunnel becomes the ONLY way in. Nobody can bypass
#            Cloudflare — and any Access policy you put on the admin hostname — by
#            hitting the VPS public IP directly. Requires cloudflared to run on this
#            same host, which is the usual setup.
#
# 0.0.0.0    Use only if cloudflared runs elsewhere (another host, or a container
#            that cannot reach the loopback interface). If you set this, the ports
#            are reachable from the internet unless a firewall blocks them, so
#            restrict 8181/8182 to the tunnel's source address.
BIND_ADDRESS=127.0.0.1

# Path layout, per hostname:
#
#   call.trip2fun.com/           web app
#   call.trip2fun.com/api/v1/*   HTTP API
#   call.trip2fun.com/rt         realtime WebSocket (Socket.IO path)
#
#   admin.trip2fun.com/          admin panel
#   admin.trip2fun.com/api/v1/*  the same HTTP API, same-origin for the admin UI
#
API_PATH_PREFIX=/api
REALTIME_PATH=/rt

# Origins the API accepts credentialed cross-origin requests from. Comma-separated.
# Keep this tight: it is the allow-list a browser enforces on behalf of your users.
CORS_ALLOWED_ORIGINS=https://call.trip2fun.com,https://admin.trip2fun.com

# Browser-visible URLs, baked into each bundle at build time.
NEXT_PUBLIC_APP_URL=https://call.trip2fun.com
NEXT_PUBLIC_API_URL=https://call.trip2fun.com/api
NEXT_PUBLIC_REALTIME_URL=https://call.trip2fun.com
NEXT_PUBLIC_REALTIME_PATH=/rt

# Admin bundle talks to the API on its own origin.
NEXT_PUBLIC_ADMIN_API_URL=https://admin.trip2fun.com/api

# ─────────────────────────────────────────────────────────────────────────────
# Ingress
# ─────────────────────────────────────────────────────────────────────────────
#
# Trip2World does NOT run its own tunnel. Ingress is your existing Cloudflare
# Tunnel, configured outside this stack, with two public hostnames:
#
#   call.trip2fun.com   ->  http://<host>:8181
#   admin.trip2fun.com  ->  http://<host>:8182
#
# Cloudflare terminates TLS; Caddy speaks plain HTTP behind it.
#
# Trust the forwarded client IP and scheme. Required behind a tunnel: without it
# every request appears to come from the tunnel, collapsing all rate limiting into
# one bucket, and the app would see http:// and refuse to set secure cookies.
TRUST_PROXY=true

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — every one of these MUST be changed. `pnpm secrets:generate` does it.
# ─────────────────────────────────────────────────────────────────────────────

# Signs access tokens. >= 32 chars; the app refuses to start otherwise.
JWT_SECRET=CHANGE_ME
# Signs session/CSRF cookies. Must differ from JWT_SECRET.
SESSION_SECRET=CHANGE_ME
# Salts IP hashes. Changing it invalidates existing abuse correlation.
IP_HASH_SALT=CHANGE_ME
# Shared with coturn as `static-auth-secret`. Never reaches a browser.
TURN_SECRET=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=trip2world
POSTGRES_USER=trip2world
POSTGRES_PASSWORD=CHANGE_ME
# Container-internal. Postgres is never published to the host.
DATABASE_URL=postgresql://trip2world:CHANGE_ME@postgres:5432/trip2world?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379
# Namespace prefix. Change to run several environments on one Redis.
REDIS_PREFIX=t2w

# ─────────────────────────────────────────────────────────────────────────────
# TURN / STUN  (coturn)
# ─────────────────────────────────────────────────────────────────────────────
#
# TURN CANNOT GO THROUGH CLOUDFLARE'S PROXY — it is UDP, and the proxy only handles
# HTTP/WebSocket. Use a DNS-only (grey cloud) A record, or your raw public IP.
# Without a reachable TURN server, users behind symmetric NAT never connect.
#
TURN_DOMAIN=turn.trip2fun.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_ENABLE_TCP=true
TURN_ENABLE_TLS=false

# The public IP coturn advertises in its relay candidates. Behind NAT this MUST be
# your WAN address, not the container's — otherwise it hands out unroutable
# candidates and every relayed call fails.
TURN_EXTERNAL_IP=

# Relay port range. Forward this whole UDP range to the host.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Development only: fall back to public STUN when no TURN is configured.
USE_PUBLIC_STUN_FALLBACK=false

# ─────────────────────────────────────────────────────────────────────────────
# Email (SMTP) — required for verification and password reset
# ─────────────────────────────────────────────────────────────────────────────
#
# Configured below for Gmail. Three things to get right:
#
#  1. SMTP_PASSWORD must be a Google APP PASSWORD (16 characters), not your
#     account password. Google removed plain-password SMTP access. Enable
#     2-Step Verification first, then create one at:
#     https://myaccount.google.com/apppasswords
#
#  2. MAIL_FROM must be the Gmail address itself, or an alias you have verified
#     under Gmail > Settings > Accounts > "Send mail as". Gmail silently rewrites
#     the From header on anything else, which breaks SPF/DKIM alignment and lands
#     your verification mail in spam.
#
#  3. Gmail enforces a hard send cap — roughly 500 recipients/day on a consumer
#     account, 2000 on Workspace. That is fine for early traffic, but a signup
#     spike will hit it and verification emails will start bouncing. Move to a
#     transactional provider (Resend, Postmark, SES) before you need to.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=
# false = STARTTLS on port 587 (correct for Gmail).
# Set true only if you switch to implicit TLS on port 465.
SMTP_SECURE=false
MAIL_FROM="Trip2World <your-account@gmail.com>"

# smtp  — send for real via the settings above.
# log   — write the message to the log instead of sending. Used automatically in
#         development so the verification flow works with no mail provider.
#         Never set this in production: nobody would receive a password reset.
MAIL_TRANSPORT=smtp

# ─────────────────────────────────────────────────────────────────────────────
# OAuth (optional — the app is fully functional without these)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Billing (optional — subscriptions stay hidden while unset)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PREMIUM=

# ─────────────────────────────────────────────────────────────────────────────
# Application behaviour
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Absolute floor is 18; this may be raised but never lowered.
MINIMUM_AGE=18
REGISTRATION_OPEN=true
REQUIRE_EMAIL_VERIFICATION=true
GUEST_ACCESS_ENABLED=false
MAINTENANCE_MODE=false

# Identifies this realtime node in presence records and logs. Must be unique when
# running more than one replica.
REALTIME_NODE_ID=rt-1

# ─────────────────────────────────────────────────────────────────────────────
# Development seeding — MUST stay unset in production
# ─────────────────────────────────────────────────────────────────────────────
# Sample accounts for testing two-browser matchmaking locally. The seed refuses to
# run these when NODE_ENV=production, and there is no default password.
SEED_DEV_USERS=false
SEED_USER_PASSWORD=
