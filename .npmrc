# Do not let pnpm self-manage its own version from the `packageManager` field.
#
# When enabled, pnpm re-downloads itself to match `packageManager`, which reintroduces
# exactly the registry round trip the Docker images avoid by installing pnpm directly.
# The version is already pinned at image build time.
manage-package-manager-versions=false

auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
node-linker=isolated
prefer-workspace-packages=true
link-workspace-packages=true
