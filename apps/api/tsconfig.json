{
  "extends": "@trip2world/config/tsconfig/node.json",
  "compilerOptions": {
    // No rootDir: the build config files sit beside src/ and are type-checked too.
    // tsup produces the actual build output, so tsc is only ever used with --noEmit.
    "outDir": "dist",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tsup.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
