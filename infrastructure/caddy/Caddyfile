# Trip2World reverse proxy.
#
# Ingress model: an EXTERNAL Cloudflare Tunnel (managed outside this stack) maps two host
# ports to two public hostnames:
#
#   http://<host>:8181  ->  https://trip2world.net        public app (and www, redirected)
#   http://<host>:8182  ->  https://admin.trip2world.net  admin panel
#
# Routing is therefore by PORT, not by Host header. That is deliberate: whatever Host the
# tunnel forwards, the port it connected to is unambiguous, so the admin panel can never
# be reached by spoofing a Host header at the public port.
#
# Port 8181 (public app):
#   /            -> web       (Next.js)
#   /api/*       -> api       (Fastify)
#   /rt          -> realtime  (Socket.IO / WebSocket)
#
# Port 8182 (admin):
#   /            -> admin     (Next.js)
#   /api/*       -> api       (the SAME container)
#
# Why /api is served on BOTH ports: putting the admin panel on its own origin only
# isolates its session if the admin UI can authenticate WITHOUT a cross-origin request.
# Serving the API on each port lets both panels call /api same-origin, so each cookie is
# host-scoped (no Domain=.trip2world.net) and an XSS in the public web bundle cannot attach
# a moderator's cookie to a request.
#
# TLS is terminated by Cloudflare. Caddy speaks plain HTTP and must never be exposed
# directly to the internet — see BIND_ADDRESS in .env.

{
	# Caddy's admin API is unauthenticated by design and would be a full remote
	# reconfiguration endpoint reachable from any container on this network.
	admin off

	servers {
		# Honour X-Forwarded-For / X-Forwarded-Proto from cloudflared so rate limiting,
		# audit logs and secure-cookie handling see the real client and scheme rather
		# than the tunnel's.
		trusted_proxies static private_ranges
	}
}

# Shared snippets ─────────────────────────────────────────────────────────────

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# getUserMedia is required for the product to work; everything else is denied.
		# Also stops an embedded third-party frame from requesting the camera.
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"

		# Drop the version banner Caddy adds by default.
		-Server
	}
}

(proxy_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
	header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
}

(app_log) {
	log {
		output stdout
		format json
		level INFO
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# :8181 — public application
# ─────────────────────────────────────────────────────────────────────────────
:8181 {
	import app_log
	import security_headers

	# Canonical hostname.
	#
	# The tunnel routes BOTH the apex and www to this port, and that is a problem the
	# moment anyone signs in: session cookies are host-scoped on purpose — no
	# `Domain=.trip2world.net`, because that would share them with the admin origin and
	# dissolve the boundary the separate port exists to create. Host-scoped means a
	# cookie set on `trip2world.net` is simply not sent to `www.trip2world.net`.
	#
	# Serving both would therefore look like this: sign in on www, click a link that
	# resolves to the apex, and you are signed out. No error, no clue why.
	#
	# One hostname serves; the other redirects. 301 so browsers and Cloudflare cache it.
	# Doing it here rather than in a Cloudflare Redirect Rule keeps it in the repo, where
	# it survives a dashboard change nobody remembers making.
	@www host www.{$APP_DOMAIN}
	redir @www https://{$APP_DOMAIN}{uri} permanent

	# Liveness for the container healthcheck and for uptime monitoring. Matched after the
	# redirect but never affected by it — the healthcheck connects to 127.0.0.1, so its
	# Host header is never the www hostname.
	handle /healthz {
		respond "ok" 200
	}

	# Realtime must match before the catch-all. Socket.IO opens with an HTTP long-poll
	# and then upgrades, so both have to reach the same backend.
	handle /rt* {
		reverse_proxy realtime:4001 {
			import proxy_headers

			# A signaling socket must not be reaped as an idle HTTP connection.
			# Socket.IO's own ping/pong is what detects a genuinely dead peer.
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	handle /api/* {
		reverse_proxy api:4000 {
			import proxy_headers
		}
	}

	handle {
		reverse_proxy web:3000 {
			import proxy_headers
		}
	}

	encode zstd gzip

	handle_errors {
		respond "Trip2World is temporarily unavailable ({err.status_code})." {err.status_code}
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# :8182 — admin panel (separate port, separate origin, separate cookie jar)
# ─────────────────────────────────────────────────────────────────────────────
:8182 {
	import app_log
	import security_headers

	handle /healthz {
		respond "ok" 200
	}

	# The admin panel is never a legitimate target for indexing or embedding.
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	# Same API container, reached same-origin so the admin cookie stays host-scoped.
	handle /api/* {
		reverse_proxy api:4000 {
			import proxy_headers
		}
	}

	handle {
		reverse_proxy admin:3000 {
			import proxy_headers
		}
	}

	encode zstd gzip

	handle_errors {
		respond "Trip2World admin is temporarily unavailable ({err.status_code})." {err.status_code}
	}
}
